<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Crossword Puzzle - Snowwords</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --icy-turquoise: #06B6D4;
      --frost-blue: #3B82F6;
      --snow-white: #FFFFFF;
      --polar-night: #0F172A;
      --slate-50: #F8FAFC;
      --slate-100: #F1F5F9;
      --slate-200: #E2E8F0;
      --slate-300: #CBD5E1;
      --slate-700: #334155;
      --cell-size: 35px;
      --gradient-primary: linear-gradient(135deg, #06B6D4 0%, #3B82F6 100%);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1);
      --success-bg: #D1FAE5;
      --success-text: #065F46;
      --success-border: #6EE7B7;
      --error-bg: #FEE2E2;
      --error-text: #991B1B;
      --error-border: #FCA5A5;
    }
    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      margin: 0;
      background: var(--slate-50);
      color: var(--polar-night);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      /* Full-height flex column so the puzzle area fills exactly the space
         under the navbar on any device, regardless of navbar height. */
      display: flex;
      flex-direction: column;
    }
    html, body {
      height: 100%;
    }
    body {
      height: 100vh;
      overflow: hidden;
    }
    .navbar {
      flex-shrink: 0;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 0.5rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 2px 20px rgba(0,0,0,0.08);
      border-bottom: 1px solid var(--slate-200);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .navbar-brand a {
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-size: 1.5rem;
      font-weight: 800;
      text-decoration: none;
      letter-spacing: -0.02em;
    }
    .nav-links {
      display: flex;
      gap: 2rem;
      align-items: center;
    }
    .nav-links a {
      color: var(--polar-night);
      text-decoration: none;
      font-weight: 500;
      transition: all .3s cubic-bezier(0.4,0,0.2,1);
    }
    .nav-links a:hover {
      color: var(--frost-blue);
    }
    .container {
      max-width: 100%;
      width: 100%;
      margin: 0 auto;
      padding: 1rem;
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .header {
      text-align: center;
      margin-bottom: 0.5rem;
    }
    .header h1 {
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-size: 1.8rem;
      font-weight: 800;
      margin: 0;
      letter-spacing: -0.03em;
    }
    .header p {
      font-size: 0.9rem;
      color: var(--slate-700);
      margin: 0.25rem 0 0 0;
    }
    .game-container {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 1rem;
      flex: 1;
      min-height: 0;
    }
    /* Left column: the clue lists, parallel to the board */
    .clues-panel {
      background: white;
      border-radius: 1rem;
      padding: 1rem;
      box-shadow: var(--shadow-xl);
      border: 1px solid var(--slate-200);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      overflow-y: auto;
    }
    /* Right column: the board, progress and controls */
    .board-panel {
      background: white;
      border-radius: 1rem;
      padding: 1rem;
      box-shadow: var(--shadow-xl);
      border: 1px solid var(--slate-200);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      min-height: 0;
      overflow: hidden;
    }
    /* Scroll area that holds just the grid; keeps controls always visible */
    .grid-scroll {
      flex: 1;
      min-height: 0;
      width: 100%;
      overflow: auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .stats-row, .controls {
      flex-shrink: 0;
    }
    .dir-note {
      font-weight: 500;
      font-size: 0.75rem;
      color: var(--slate-700);
    }
    .stats-row {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .crossword-grid {
      display: grid;
      gap: 1px;
      background: var(--slate-300);
      padding: 1px;
      border-radius: 0.5rem;
      margin-bottom: 1rem;
      width: fit-content;
      margin-left: auto;
      margin-right: auto;
    }
    .cell-wrapper {
      position: relative;
      width: var(--cell-size);
      height: var(--cell-size);
    }
    .crossword-cell {
      width: 100%;
      height: 100%;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 1.1rem;
      border: none;
      outline: none;
      text-transform: uppercase;
      text-align: center;
      transition: all .2s;
      cursor: pointer;
      padding: 0;
    }
    .cell-number {
      position: absolute;
      top: 1px;
      left: 2px;
      font-size: 0.55rem;
      color: var(--frost-blue);
      font-weight: 700;
      line-height: 1;
      z-index: 2;
      pointer-events: none;
    }
    .crossword-cell:focus {
      background: rgba(59,130,246,0.15);
      color: var(--frost-blue);
      box-shadow: inset 0 0 0 2px var(--frost-blue);
      z-index: 10;
    }
    .crossword-cell.highlighted {
      background: rgba(59,130,246,0.08);
      box-shadow: inset 0 0 0 1px var(--frost-blue);
    }
    .crossword-cell.black {
      background: var(--polar-night);
      cursor: default;
    }
    .crossword-cell.correct {
      background: var(--success-bg);
      color: var(--success-text);
    }
    .crossword-cell.incorrect {
      background: var(--error-bg);
      color: var(--error-text);
      animation: shake 0.4s;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }
    .clues-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .clues-column {
      min-width: 0;
    }
    .clues-column h3 {
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin: 0 0 0.5rem 0;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--slate-200);
      font-weight: 700;
      font-size: 1rem;
      position: sticky;
      top: 0;
      background: white;
      z-index: 5;
    }
    .clue-item {
      margin-bottom: 0.5rem;
      padding: 0.5rem;
      border-radius: 0.5rem;
      cursor: pointer;
      transition: all .2s cubic-bezier(0.4,0,0.2,1);
      border: 2px solid transparent;
      background: var(--slate-50);
      font-size: 0.85rem;
    }
    .clue-item:hover {
      background: white;
      border-color: var(--slate-200);
      transform: translateX(3px);
    }
    .clue-item.active {
      background: rgba(59,130,246,0.1);
      border-color: var(--frost-blue);
      border-left-width: 4px;
    }
    .clue-number {
      font-weight: 800;
      color: var(--frost-blue);
      margin-right: 0.5rem;
      font-size: 1.1rem;
    }
    .sidebar {
      background: white;
      border-radius: 1rem;
      padding: 1rem;
      box-shadow: var(--shadow-xl);
      border: 1px solid var(--slate-200);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 76px;
    }
    .stats {
      margin-bottom: 1rem;
    }
    .stats h3 {
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-size: 1rem;
      margin: 0 0 0.5rem 0;
    }
    .stat-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      padding: 0.5rem;
      background: var(--slate-50);
      border-radius: 0.5rem;
      font-weight: 600;
      font-size: 0.85rem;
    }
    .stat-item span:last-child {
      color: var(--frost-blue);
      font-size: 0.95rem;
    }
    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
    }
    .btn {
      padding: 0.6rem 1rem;
      border: none;
      border-radius: 0.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all .3s cubic-bezier(0.4,0,0.2,1);
      text-decoration: none;
      text-align: center;
      display: block;
      font-family: inherit;
    }
    .btn-primary {
      background: var(--gradient-primary);
      color: white;
      box-shadow: 0 4px 15px rgba(6,182,212,0.3);
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(6,182,212,0.4);
    }
    .btn-primary:active {
      transform: translateY(0);
    }
    .btn-secondary {
      background: white;
      color: var(--polar-night);
      border: 2px solid var(--slate-200);
    }
    .btn-secondary:hover {
      border-color: var(--frost-blue);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }
    .loading {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--frost-blue);
    }
    .loading-spinner {
      width: 60px;
      height: 60px;
      border: 5px solid var(--slate-200);
      border-radius: 50%;
      border-top-color: var(--frost-blue);
      animation: spin 1s ease-in-out infinite;
      margin: 0 auto 1.5rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .error {
      background: var(--error-bg);
      color: var(--error-text);
      padding: 2rem;
      border-radius: 1rem;
      margin-bottom: 1rem;
      border: 1px solid var(--error-border);
    }
    .error h3 {
      margin-top: 0;
      font-size: 1.5rem;
    }
    .success {
      background: var(--success-bg);
      color: var(--success-text);
      padding: 1.5rem;
      border-radius: 1rem;
      margin-bottom: 1rem;
      border: 1px solid var(--success-border);
      font-weight: 600;
      text-align: center;
    }
    .alert {
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      margin-bottom: 0.5rem;
      font-weight: 500;
      font-size: 0.85rem;
    }
    .alert-info {
      background: rgba(59,130,246,0.1);
      color: var(--frost-blue);
      border: 1px solid rgba(59,130,246,0.3);
    }
    @media (max-width: 1024px) {
      :root {
        --cell-size: 42px;
      }
      /* On narrow screens stack the board above the clues and allow scroll */
      html, body {
        height: auto;
      }
      body {
        height: auto;
        overflow: auto;
      }
      .container {
        flex: none;
        overflow: visible;
      }
      .game-container {
        grid-template-columns: 1fr;
      }
      .board-panel {
        order: -1;
        overflow: visible;
      }
      .grid-scroll {
        max-height: 65vh;
      }
      .clues-panel {
        overflow: visible;
      }
      .crossword-cell {
        font-size: 1.2rem;
      }
    }
    @media (max-width: 768px) {
      :root {
        --cell-size: 38px;
      }
      .clues-section {
        grid-template-columns: 1fr;
      }
      .crossword-cell {
        font-size: 1.1rem;
      }
      .header h1 {
        font-size: 2.2rem;
      }
      .container {
        padding: 1rem;
      }
      .crossword-area {
        padding: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="navbar-brand"><a href="/">❄️ Snowwords</a></div>
    <div class="nav-links">
      <a href="/profile">Profile</a>
      <a href="/vocab">Vocab</a>
      <a href="/activities">Activities</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <div class="header">
      <h1>🧩 Crossword Puzzle</h1>
      <p>Challenge yourself with words from your vocabulary!</p>
    </div>

    <% if (user.subscriptionstatus !== 'premium') { %>
      <div class="alert alert-info">
        ⏰ Free users get <strong>1 crossword per day</strong> •
        <a href="/subscription/plans" style="color:var(--frost-blue);text-decoration:none;font-weight:700">Upgrade to Premium</a> for unlimited puzzles!
      </div>
    <% } %>

    <div id="loading" class="loading">
      <div class="loading-spinner"></div>
      <p style="font-size:1.1rem;font-weight:500">Generating your personalized crossword puzzle...</p>
    </div>

    <div id="not-enough-words" class="error" style="display:none">
      <h3>📚 Need More Words!</h3>
      <p>You need at least <strong>5 words</strong> in your vocabulary to generate a crossword puzzle.</p>
      <p>Current words in your vocabulary: <span id="word-count">0</span></p>
      <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap">
        <a href="/chat" class="btn btn-primary">Chat with AI to Add Words</a>
        <a href="/vocab" class="btn btn-secondary">View Your Vocabulary</a>
      </div>
    </div>

    <div id="daily-limit-reached" class="error" style="display:none">
      <h3>⏰ Daily Limit Reached</h3>
      <p>You've already played today's crossword puzzle!</p>
      <% if (user.subscriptionstatus !== 'premium') { %>
        <p style="margin-top:1rem">Free users get <strong>1 crossword per day</strong>. Come back tomorrow for a new puzzle, or upgrade to Premium for unlimited crosswords!</p>
        <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap">
          <a href="/subscription/plans" class="btn btn-primary">⭐ Upgrade to Premium</a>
          <a href="/activities" class="btn btn-secondary">Back to Activities</a>
        </div>
      <% } else { %>
        <p style="margin-top:1rem">Please try again tomorrow for a new puzzle!</p>
        <div style="margin-top:2rem">
          <a href="/activities" class="btn btn-primary">Back to Activities</a>
        </div>
      <% } %>
    </div>

    <div id="game" style="display:none">
      <div class="game-container">
        <!-- Clues on the left, parallel to the board -->
        <div class="clues-panel">
          <div class="clues-column">
            <h3>→ Across <span class="dir-note">(horizontal)</span></h3>
            <div id="across-clues"></div>
          </div>
          <div class="clues-column">
            <h3>↓ Down <span class="dir-note">(vertical)</span></h3>
            <div id="down-clues"></div>
          </div>
        </div>

        <!-- Board + progress + controls on the right -->
        <div class="board-panel">
          <div class="grid-scroll">
            <div id="crossword-grid" class="crossword-grid"></div>
          </div>

          <div class="stats-row">
            <div class="stat-item"><span>Completed:</span> <span id="completed-count">0</span></div>
            <div class="stat-item"><span>Total:</span> <span id="total-count">0</span></div>
            <div class="stat-item"><span>Progress:</span> <span id="accuracy">0%</span></div>
          </div>

          <div class="controls">
            <button class="btn btn-primary" id="check-answers">✓ Check Answers</button>
            <button class="btn btn-secondary" id="reveal-answer">💡 Reveal Word</button>
            <button class="btn btn-secondary" id="new-puzzle">🔄 New Puzzle</button>
            <a href="/activities" class="btn btn-secondary">← Back to Activities</a>
          </div>
        </div>
      </div>
    </div>

    <div id="error" class="error" style="display:none"></div>
    <div id="success" class="success" style="display:none"></div>
  </div>

  <script>
    let crosswordData = null;
    let currentDirection = 'across';
    let completedWords = new Set();
    let currentCell = null;

    async function initCrossword() {
      try {
        const csrfMeta = document.querySelector('meta[name="csrf-token"]');
        if (!csrfMeta) {
          throw new Error('CSRF token not found. Please refresh the page.');
        }
        const csrf = csrfMeta.getAttribute('content');

        console.log('Initiating crossword generation...');
        console.log('CSRF token present:', !!csrf);

        const response = await fetch('/api/premium/crossword/generate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrf
          },
          credentials: 'same-origin'
        });

        console.log('Response status:', response.status);
        console.log('Response ok:', response.ok);

        if (!response.ok) {
          const data = await response.json().catch(() => ({}));
          console.error('API error:', data);

          // Not enough words error
          if (data.error && data.error.includes('least 5 words')) {
            document.getElementById('loading').style.display = 'none';
            document.getElementById('not-enough-words').style.display = 'block';
            try {
              const countRes = await fetch('/api/vocab/count');
              if (countRes.ok) {
                const { count } = await countRes.json();
                document.getElementById('word-count').textContent = count || 0;
              }
            } catch(err) {
              console.error('Failed to fetch word count:', err);
            }
            return;
          }

          // Daily limit error
          if (response.status === 429 || data.limitReached) {
            document.getElementById('loading').style.display = 'none';
            document.getElementById('daily-limit-reached').style.display = 'block';
            return;
          }

          throw new Error(data.error || 'Failed to generate crossword');
        }

        // Guard against a non-JSON response (e.g. an auth/redirect HTML page)
        try {
          crosswordData = await response.json();
        } catch (parseErr) {
          console.error('Response was not JSON:', parseErr);
          document.getElementById('loading').style.display = 'none';
          const errorEl = document.getElementById('error');
          errorEl.innerHTML = '<h3>⚠️ Couldn\'t load puzzle</h3><p>Please make sure you\'re signed in, then refresh and try again.</p><a href="/activities" class="btn btn-primary" style="margin-top:1rem;display:inline-block">Back to Activities</a>';
          errorEl.style.display = 'block';
          return;
        }
        console.log('Crossword data loaded:', crosswordData);

        // Show the game first so the grid can measure itself and scale to fit
        document.getElementById('loading').style.display = 'none';
        document.getElementById('game').style.display = 'block';

        renderCrossword();
        renderClues();
        updateStats();
        fitGrid();
        observeGridFit();

        // Focus first fillable cell
        const firstCell = document.querySelector('#crossword-grid input.crossword-cell:not(.black)');
        if (firstCell) {
          firstCell.focus();
          currentCell = firstCell;
        }
      } catch (err) {
        console.error('Failed to initialize crossword:', err);
        document.getElementById('loading').style.display = 'none';
        const errorEl = document.getElementById('error');
        errorEl.innerHTML = '<h3>⚠️ Error</h3><p>Failed to load crossword puzzle. Please try again.</p><a href="/activities" class="btn btn-primary" style="margin-top:1rem;display:inline-block">Back to Activities</a>';
        errorEl.style.display = 'block';
      }
    }

    function renderCrossword() {
      const gridEl = document.getElementById('crossword-grid');
      gridEl.innerHTML = '';
      const size = crosswordData.size;
      const grid = crosswordData.grid;

      // Each grid cell is an object like { value, number, across, down }.
      // Crop to the bounding box of the actual letters so we render a compact
      // puzzle instead of a huge, mostly-black 15x15 board.
      let minRow = size, maxRow = -1, minCol = size, maxCol = -1;
      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          if (grid[r][c].value !== '#') {
            if (r < minRow) minRow = r;
            if (r > maxRow) maxRow = r;
            if (c < minCol) minCol = c;
            if (c > maxCol) maxCol = c;
          }
        }
      }
      if (maxRow < 0) { minRow = maxRow = minCol = maxCol = 0; }

      const cols = maxCol - minCol + 1;
      const rows = maxRow - minRow + 1;
      gridEl.dataset.cols = cols;
      gridEl.dataset.rows = rows;
      gridEl.style.gridTemplateColumns = `repeat(${cols}, var(--cell-size))`;

      for (let row = minRow; row <= maxRow; row++) {
        for (let col = minCol; col <= maxCol; col++) {
          const cellData = grid[row][col];

          // Wrap each cell so we can overlay a clue number (inputs can't
          // render ::before/::after, so the number must be a real element).
          const wrapper = document.createElement('div');
          wrapper.className = 'cell-wrapper';

          const cell = document.createElement('input');
          cell.type = 'text';
          cell.className = 'crossword-cell';
          cell.maxLength = 1;

          if (cellData.value === '#') {
            cell.classList.add('black');
            cell.disabled = true;
            cell.tabIndex = -1;
          } else {
            // Keep absolute row/col so neighbour lookups keep working
            cell.dataset.row = row;
            cell.dataset.col = col;
            if (cellData.across != null) cell.dataset.across = cellData.across;
            if (cellData.down != null) cell.dataset.down = cellData.down;
            if (cellData.number) {
              cell.dataset.number = cellData.number;
              const numEl = document.createElement('span');
              numEl.className = 'cell-number';
              numEl.textContent = cellData.number;
              wrapper.appendChild(numEl);
            }

            cell.addEventListener('input', handleCellInput);
            cell.addEventListener('keydown', handleKeyDown);
            cell.addEventListener('click', () => selectCell(cell));
            cell.addEventListener('focus', () => {
              currentCell = cell;
              highlightCurrentWord(cell);
              // Select the existing letter so typing overwrites it (maxLength=1)
              cell.select();
            });
          }

          wrapper.appendChild(cell);
          gridEl.appendChild(wrapper);
        }
      }

      fitGrid();
    }

    // Scale the cells so the whole board fits inside its scroll area, based on
    // the actual measured space (adapts to any screen / device / orientation).
    function fitGrid() {
      const gridEl = document.getElementById('crossword-grid');
      if (!gridEl) return;
      const scroll = gridEl.parentElement;
      const cols = parseInt(gridEl.dataset.cols || '0');
      const rows = parseInt(gridEl.dataset.rows || '0');
      if (!cols || !rows) return;

      const availW = scroll.clientWidth;
      const availH = scroll.clientHeight;
      if (availW <= 0 || availH <= 0) return; // not visible yet

      // (cols-1) accounts for the 1px gaps between cells
      const byW = Math.floor((availW - (cols - 1)) / cols);
      const byH = Math.floor((availH - (rows - 1)) / rows);
      let size = Math.min(44, byW, byH);
      size = Math.max(size, 16);
      gridEl.style.setProperty('--cell-size', size + 'px');
    }

    // Re-fit on any size change of the board area (covers every device,
    // window resize, orientation change, font load, etc.).
    let __gridObserver = null;
    function observeGridFit() {
      const gridEl = document.getElementById('crossword-grid');
      if (!gridEl || !gridEl.parentElement) return;
      if (typeof ResizeObserver !== 'undefined' && !__gridObserver) {
        __gridObserver = new ResizeObserver(() => fitGrid());
        __gridObserver.observe(gridEl.parentElement);
      }
      // A couple of deferred passes in case layout/fonts settle after render
      requestAnimationFrame(fitGrid);
      setTimeout(fitGrid, 150);
    }
    window.addEventListener('resize', fitGrid);
    window.addEventListener('orientationchange', () => setTimeout(fitGrid, 200));
    window.addEventListener('load', fitGrid);

    function renderClues() {
      const acrossEl = document.getElementById('across-clues');
      const downEl = document.getElementById('down-clues');
      acrossEl.innerHTML = '';
      downEl.innerHTML = '';

      crosswordData.clues.across.forEach(clue => {
        const el = document.createElement('div');
        el.className = 'clue-item';
        el.innerHTML = `<span class="clue-number">${clue.number}.</span>${clue.clue}`;
        el.addEventListener('click', () => selectClue(clue, 'across'));
        acrossEl.appendChild(el);
      });

      crosswordData.clues.down.forEach(clue => {
        const el = document.createElement('div');
        el.className = 'clue-item';
        el.innerHTML = `<span class="clue-number">${clue.number}.</span>${clue.clue}`;
        el.addEventListener('click', () => selectClue(clue, 'down'));
        downEl.appendChild(el);
      });
    }

    function handleCellInput(e) {
      const cell = e.target;
      let val = (cell.value || '').toUpperCase();

      // Clear any previous check styling
      cell.classList.remove('correct', 'incorrect');

      if (val.length > 1) {
        // If multiple characters somehow landed in the cell, keep the last one
        val = val[val.length - 1];
      }

      if (/^[A-Z]$/.test(val)) {
        // Standard crossword behaviour: overwrite this cell and advance
        cell.value = val;
        checkWordCompletion();
        moveNext(cell);
      } else {
        // Non-letter input: clear the cell
        cell.value = '';
        checkWordCompletion();
      }
    }

    function handleKeyDown(e) {
      const cell = e.target;

      if (e.key === 'Backspace') {
        e.preventDefault();
        if (cell.value) {
          // Clear the current cell and stay put
          cell.value = '';
          cell.classList.remove('correct', 'incorrect');
          checkWordCompletion();
        } else {
          // Already empty: step back to the previous cell and clear it
          movePrev(cell);
          checkWordCompletion();
        }
      } else if (e.key === 'Delete') {
        e.preventDefault();
        cell.value = '';
        cell.classList.remove('correct', 'incorrect');
        checkWordCompletion();
      } else if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
        e.preventDefault();
        moveArrow(cell, e.key);
      } else if (e.key === 'Tab') {
        e.preventDefault();
        jumpToNextWord();
      } else if (e.key === ' ') {
        e.preventDefault();
        toggleDirection();
      }
    }

    function moveNext(cell) {
      const r = parseInt(cell.dataset.row);
      const c = parseInt(cell.dataset.col);
      let nextCell;

      if (currentDirection === 'across') {
        nextCell = document.querySelector(`[data-row="${r}"][data-col="${c + 1}"]`);
      } else {
        nextCell = document.querySelector(`[data-row="${r + 1}"][data-col="${c}"]`);
      }

      if (nextCell && !nextCell.disabled) {
        nextCell.focus();
      }
    }

    function movePrev(cell) {
      const r = parseInt(cell.dataset.row);
      const c = parseInt(cell.dataset.col);
      let prevCell;

      if (currentDirection === 'across') {
        prevCell = document.querySelector(`[data-row="${r}"][data-col="${c - 1}"]`);
      } else {
        prevCell = document.querySelector(`[data-row="${r - 1}"][data-col="${c}"]`);
      }

      if (prevCell && !prevCell.disabled) {
        prevCell.focus();
        prevCell.value = '';
      }
    }

    function moveArrow(cell, key) {
      const r = parseInt(cell.dataset.row);
      const c = parseInt(cell.dataset.col);
      let nextCell;

      if (key === 'ArrowRight') {
        nextCell = document.querySelector(`[data-row="${r}"][data-col="${c + 1}"]`);
        currentDirection = 'across';
      } else if (key === 'ArrowLeft') {
        nextCell = document.querySelector(`[data-row="${r}"][data-col="${c - 1}"]`);
        currentDirection = 'across';
      } else if (key === 'ArrowDown') {
        nextCell = document.querySelector(`[data-row="${r + 1}"][data-col="${c}"]`);
        currentDirection = 'down';
      } else if (key === 'ArrowUp') {
        nextCell = document.querySelector(`[data-row="${r - 1}"][data-col="${c}"]`);
        currentDirection = 'down';
      }

      if (nextCell && !nextCell.disabled) {
        nextCell.focus();
      }
    }

    function selectCell(cell) {
      // Toggle direction if clicking the same cell
      if (currentCell === cell) {
        if (cell.dataset.across && cell.dataset.down) {
          currentDirection = currentDirection === 'across' ? 'down' : 'across';
        }
      } else {
        // Set direction based on what's available
        if (cell.dataset.across && !cell.dataset.down) {
          currentDirection = 'across';
        } else if (cell.dataset.down && !cell.dataset.across) {
          currentDirection = 'down';
        }
      }
      cell.focus();
      highlightCurrentWord(cell);
    }

    function highlightCurrentWord(cell) {
      // Remove all previous highlights
      document.querySelectorAll('.crossword-cell.highlighted').forEach(c => {
        c.classList.remove('highlighted');
      });

      // Get the clue number for the current direction
      const clueNumber = currentDirection === 'across' ? cell.dataset.across : cell.dataset.down;
      if (!clueNumber) return;

      // Highlight all cells with the same clue number in the same direction
      const selector = `[data-${currentDirection}="${clueNumber}"]`;
      document.querySelectorAll(selector).forEach(c => {
        if (c !== cell) {  // Don't highlight the focused cell
          c.classList.add('highlighted');
        }
      });
    }

    function toggleDirection() {
      if (currentCell && currentCell.dataset.across && currentCell.dataset.down) {
        currentDirection = currentDirection === 'across' ? 'down' : 'across';
      }
    }

    function selectClue(clue, dir) {
      currentDirection = dir;

      // Find first cell of this clue
      const firstCell = document.querySelector(`[data-${dir}="${clue.number}"][data-number]`) ||
                        document.querySelector(`[data-${dir}="${clue.number}"]`);

      if (firstCell) {
        firstCell.focus();
      }

      // Highlight active clue
      document.querySelectorAll('.clue-item').forEach(el => el.classList.remove('active'));
      const clueItems = [...document.querySelectorAll('.clue-item')];
      const activeClue = clueItems.find(el =>
        el.textContent.trim().startsWith(String(clue.number) + '.')
      );
      if (activeClue) {
        activeClue.classList.add('active');
      }
    }

    function getWordFromClue(clue, dir) {
      const cells = document.querySelectorAll(`[data-${dir}="${clue.number}"]`);
      return Array.from(cells).map(c => c.value || '').join('').toUpperCase();
    }

    function checkWordCompletion() {
      completedWords.clear();

      // Check across clues
      crosswordData.clues.across.forEach(clue => {
        const userAnswer = getWordFromClue(clue, 'across');
        if (userAnswer === clue.answer) {
          completedWords.add(clue.number + 'a');
        }
      });

      // Check down clues
      crosswordData.clues.down.forEach(clue => {
        const userAnswer = getWordFromClue(clue, 'down');
        if (userAnswer === clue.answer) {
          completedWords.add(clue.number + 'd');
        }
      });

      updateStats();
    }

    function updateStats() {
      const total = crosswordData.clues.across.length + crosswordData.clues.down.length;
      const done = completedWords.size;
      const progress = total > 0 ? Math.round((done / total) * 100) : 0;

      document.getElementById('completed-count').textContent = done;
      document.getElementById('total-count').textContent = total;
      document.getElementById('accuracy').textContent = progress + '%';

      // Check if puzzle is complete
      if (progress === 100) {
        showSuccess('🎉 Congratulations! You completed the puzzle!');
      }
    }

    function jumpToNextWord() {
      const clueItems = [...document.querySelectorAll('.clue-item')];
      const activeIndex = clueItems.findIndex(el => el.classList.contains('active'));
      const nextIndex = (activeIndex + 1) % clueItems.length;
      clueItems[nextIndex]?.click();
    }

    function showSuccess(message) {
      const el = document.getElementById('success');
      el.textContent = message;
      el.style.display = 'block';
      setTimeout(() => {
        el.style.display = 'none';
      }, 5000);
    }

    function showError(message) {
      const el = document.getElementById('error');
      el.innerHTML = '<h3>⚠️ Error</h3><p>' + message + '</p>';
      el.style.display = 'block';
      setTimeout(() => {
        el.style.display = 'none';
      }, 5000);
    }

    // Event listeners
    document.getElementById('check-answers').addEventListener('click', () => {
      checkWordCompletion();

      // Highlight correct and incorrect cells
      crosswordData.clues.across.forEach(clue => {
        const cells = document.querySelectorAll(`[data-across="${clue.number}"]`);
        const userAnswer = getWordFromClue(clue, 'across');
        cells.forEach((cell, i) => {
          cell.classList.remove('correct', 'incorrect');
          if (userAnswer === clue.answer) {
            cell.classList.add('correct');
          } else if (cell.value) {
            cell.classList.add('incorrect');
          }
        });
      });

      crosswordData.clues.down.forEach(clue => {
        const cells = document.querySelectorAll(`[data-down="${clue.number}"]`);
        const userAnswer = getWordFromClue(clue, 'down');
        cells.forEach((cell, i) => {
          if (!cell.classList.contains('correct')) {
            cell.classList.remove('incorrect');
            if (userAnswer === clue.answer) {
              cell.classList.add('correct');
            } else if (cell.value) {
              cell.classList.add('incorrect');
            }
          }
        });
      });

      const progress = parseInt(document.getElementById('accuracy').textContent);
      if (progress === 100) {
        showSuccess('🎉 Perfect! You completed the crossword!');
      } else {
        showSuccess(`Good progress! You're ${progress}% complete.`);
      }
    });

    document.getElementById('new-puzzle').addEventListener('click', () => {
      if (confirm('Are you sure you want to start a new puzzle? This will clear your current progress.')) {
        location.reload();
      }
    });

    document.getElementById('reveal-answer').addEventListener('click', () => {
      // Find an incomplete word in current direction
      const incompleteWords = [];

      crosswordData.clues[currentDirection].forEach(clue => {
        const userAnswer = getWordFromClue(clue, currentDirection);
        if (userAnswer !== clue.answer) {
          incompleteWords.push(clue);
        }
      });

      if (incompleteWords.length === 0) {
        // Try the other direction
        const otherDir = currentDirection === 'across' ? 'down' : 'across';
        crosswordData.clues[otherDir].forEach(clue => {
          const userAnswer = getWordFromClue(clue, otherDir);
          if (userAnswer !== clue.answer) {
            incompleteWords.push({ ...clue, dir: otherDir });
          }
        });
      }

      if (incompleteWords.length > 0) {
        const randomWord = incompleteWords[Math.floor(Math.random() * incompleteWords.length)];
        const dir = randomWord.dir || currentDirection;
        const cells = document.querySelectorAll(`[data-${dir}="${randomWord.number}"]`);

        // Fill in the answer
        cells.forEach((cell, i) => {
          cell.value = randomWord.answer[i];
          cell.classList.add('correct');
        });

        checkWordCompletion();
        showSuccess(`Revealed: ${randomWord.answer} (${dir} ${randomWord.number})`);
      } else {
        showSuccess('All words are already complete!');
      }
    });

    // Initialize crossword on page load
    document.addEventListener('DOMContentLoaded', initCrossword);
  </script>
</body>
</html>
