<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" href="/favicon.ico?v=2" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <link rel="manifest" href="/site.webmanifest">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Log In - Snowwords</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      /* Fill the viewport on large screens, but allow scrolling when the
         content is taller than the screen (e.g. on phones). */
      html, body {
        min-height: 100vh;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
      }

      :root {
        --icy-turquoise: #06B6D4;
        --frost-blue: #3B82F6;
        --snow-white: #FFFFFF;
        --polar-night: #0F172A;
        --slate-50: #F8FAFC;
        --slate-100: #F1F5F9;
        --slate-200: #E2E8F0;
        --slate-700: #334155;
        --gradient-primary: linear-gradient(135deg, #06B6D4 0%, #3B82F6 100%);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1);
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--polar-night);
        background: var(--slate-50);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }
      
      .container {
        width: 90%;
        max-width: 1200px;
        margin: 0 auto;
        padding: min(2rem, 2vh);
      }
      
      /* Divide the page into two vertical sections */
      .top-section {
        flex: 0 0 auto;
      }
      
      .section-sky {
        flex: 1 1 auto;
        background: linear-gradient(160deg, var(--frost-blue) 0%, var(--icy-turquoise) 100%);
        color: var(--snow-white);
        /* Use flex layout to center the content vertically and horizontally */
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: min(4rem, 4vh) min(2rem, 2vw);
        position: relative;
        overflow: hidden;
      }

      .section-sky h1 {
        font-size: min(2.8rem, 5vh);
        margin-bottom: min(1.5rem, 2vh);
      }
      
      .login-card {
        background: white;
        border-radius: 20px;
        padding: min(3rem, 4vh) min(2.5rem, 3vw);
        box-shadow: var(--shadow-xl);
        width: 90%;
        max-width: 500px;
        margin: min(2rem, 2vh) auto;
        position: relative;
        border: 1px solid var(--slate-200);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .login-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15);
      }

      .login-card h2 {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-align: center;
        margin-bottom: min(2rem, 2vh);
        font-size: min(2rem, 3.5vh);
        font-weight: 700;
      }

      form label {
        display: block;
        margin: min(1.5rem, 1.5vh) 0 min(0.5rem, 0.5vh);
        color: var(--slate-700);
        font-weight: 600;
        font-size: 0.95rem;
      }

      form input {
        width: 100%;
        padding: min(1rem, 1.2vh);
        border: 2px solid var(--slate-200);
        border-radius: 12px;
        font-size: min(1rem, 2vh);
        margin-bottom: min(1rem, 1vh);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-sizing: border-box;
        background: var(--slate-50);
      }

      form input:focus {
        outline: none;
        border-color: var(--frost-blue);
        background: white;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
      }
      
      .btn {
        background: var(--gradient-primary);
        color: white;
        width: 100%;
        padding: min(1rem, 1.5vh) min(2rem, 2vw);
        border: none;
        border-radius: 12px;
        font-size: min(1.1rem, 2.2vh);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: min(1.5rem, 1.5vh);
        box-shadow: 0 4px 15px rgba(6, 182, 212, 0.3);
      }

      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(6, 182, 212, 0.4);
      }
      
      .badge-warm {
        background: #ffcccc;
        color: #cc0000;
        padding: min(1rem, 1vh);
        border-radius: 8px;
        width: 100%;
        text-align: center;
        margin: min(1rem, 1vh) 0;
        box-sizing: border-box;
      }

      .text-center {
        text-align: center;
        margin: min(2rem, 2vh) 0;
        font-size: min(1rem, 2vh);
      }
      
      .text-center a {
        color: var(--frost-blue);
        text-decoration: none;
        font-weight: 500;
      }
      
      .text-center a:hover {
        text-decoration: underline;
      }
      
      .btn-google {
        background: white;
        color: #4285f4;
        width: 100%;
        padding: min(1rem, 1.2vh);
        border: 2px solid var(--slate-200);
        border-radius: 12px;
        font-size: min(1rem, 2vh);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: min(1rem, 1vh);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-sizing: border-box;
        text-decoration: none;
      }

      .btn-google:hover {
        background: var(--slate-50);
        border-color: #4285f4;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(66, 133, 244, 0.15);
      }

      .google-icon {
        width: min(18px, 3vh);
        height: min(18px, 3vh);
      }
      
      .divider {
        display: flex;
        align-items: center;
        margin: min(1.5rem, 1.5vh) 0;
        color: var(--slate-700);
        font-size: 0.9rem;
        font-weight: 500;
      }

      .divider::before,
      .divider::after {
        content: "";
        flex: 1;
        border-top: 2px solid var(--slate-200);
        margin: 0 0.5rem;
      }
      
      /* For very small screens */
      @media (max-width: 480px) or (max-height: 600px) {
        .login-card {
          padding: min(1rem, 3vh);
          margin: min(0.5rem, 1vh) auto;
          width: 95%;
        }

        .container {
          width: 95%;
          padding: min(1rem, 1vh);
        }

        /* Further reduce spacing on very small screens */
        form label {
          margin: min(0.5rem, 0.5vh) 0 min(0.3rem, 0.3vh);
        }

        form input {
          margin-bottom: min(0.5rem, 0.5vh);
          padding: min(0.6rem, 0.8vh);
        }

        .btn, .btn-google {
          padding: min(0.8rem, 1vh);
        }

        .text-center {
          margin: min(1rem, 1vh) 0;
        }

        /* Ensure hero section is not too large */
        .section-sky {
          padding: min(2rem, 2vh) min(1rem, 1vw);
        }
      }

      /* Ensure content fits on really small devices */
      @media (max-height: 500px) {
        .section-sky {
          display: none;
        }

        .top-section {
          max-height: 100vh;
        }
      }
    </style>
  </head>
  <body>
    <!-- Top Section: Form and Links -->
    <div class="top-section">
      <div class="container">
        <div class="login-card">
          <h2>Log In to Your Snowwords</h2>
          
          <% if (error) { %>
            <div class="badge-warm">
              <%= error %>
            </div>
          <% } %>
  
          <form action="/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>
  
            <label for="password">Password:</label>
            <input type="password" id="password" name="password" required>
  
            <button class="btn" type="submit">Melt Into Learning</button>
  
            <div class="divider">or</div>
  
            <a href="/auth/google" class="btn-google">
              <svg class="google-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 488 512">
                <path d="M488 261.8C488 403.3 391.1 504 248 504 110.8 504 0 393.2 0 256S110.8 8 248 8c66.8 0 123 24.5 166.3 64.9l-67.5 64.9C258.5 52.6 94.3 116.6 94.3 256c0 86.5 69.1 156.6 153.7 156.6 98.2 0 135-70.4 140.8-106.9H248v-85.3h236.1c2.3 12.7 3.9 24.9 3.9 41.4z"/>
              </svg>
              Log In with Google
            </a>
          </form>
        </div>
        <div class="text-center">
          <p>Don't have an account? <a href="/signup">Start your journey here</a></p>
          <p><a href="/">Back to Home</a></p>
        </div>
      </div>
    </div>
  
    <!-- Hero Section -->
    <section class="section-sky">
      <div class="container">
        <h1>Welcome Back to Snowwords ❄️</h1>
      </div>
    </section>
  </body>
</html>
